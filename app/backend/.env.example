# Copy to app/backend/.env and fill in. Never commit the filled-in copy.
# `.env` is gitignored; this example is not, so it must never carry a real value.
#
# Every name here is prefixed HAWKEYE_ because Settings uses
# env_prefix="HAWKEYE_" (see hawkeye_backend/config.py). A variable without
# that prefix is read by nothing, silently.

# ---- the one switch ----
# "simulated" needs no hardware and no agents up. "live" talks to agents/master
# and returns 503 rather than inventing state when the mesh is down.
HAWKEYE_MODE=simulated

# ---- identity and address ----
HAWKEYE_HUB_NAME=Hawk Eye Hub
HAWKEYE_SITE_ID=site-demo-01
HAWKEYE_SITE_ADDRESS=1872 Ridgeview Lane, Blacksburg VA 24060
HAWKEYE_SITE_TIMEZONE=America/New_York

# ---- notices ----
# Seconds an unexpected presence must hold before it becomes a notice.
HAWKEYE_NOTICE_HOLD_S=5
# Seconds of absence after which a fired notice mark lapses, so a genuine
# re-entry notifies again and a brief CSI dropout does not.
HAWKEYE_NOTICE_FORGET_AFTER_S=900

# ---- Twilio, for the SMS sink ----
# ALL FOUR are required together. Three out of four reads as unconfigured and
# logs "notices: twilio not configured, in-app banner only", so the in-app
# banner still works and no text ever arrives. That failure looks exactly like
# Twilio being slow. Check the startup log line, not the banner.
#
# The account SID and auth token come from the Twilio console dashboard.
# The from number is the Twilio number itself. On a trial account the TO number
# must be verified in the console first, and every message arrives prefixed
# "Sent from your Twilio trial account".
HAWKEYE_TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
HAWKEYE_TWILIO_AUTH_TOKEN=00000000000000000000000000000000
HAWKEYE_TWILIO_FROM_NUMBER=+15550001111
HAWKEYE_TWILIO_TO_NUMBER=+15550002222

# Rate limits on the SMS sink. A rehearsal loop must not send fifty texts and a
# bug in the trigger must not burn the trial credit.
HAWKEYE_TWILIO_MIN_INTERVAL_S=60
HAWKEYE_TWILIO_MAX_PER_INSTANCE=5

# ---- storage ----
# The hub's whole working state. "memory" is the hackathon path and needs
# nothing else. "mongodb" is NOT implemented; MongoStore in store.py raises
# rather than silently degrading. Leave this on memory.
HAWKEYE_STORE_BACKEND=memory

# ---- replay archive ----
# Where a SEALED record goes so it outlives the process that wrote it. This is
# separate from HAWKEYE_STORE_BACKEND on purpose, and the pairing below -
# memory store, mongodb archive - is the intended configuration rather than a
# half-finished one.
#
# The store is on the incident path: motion has to reach a wrist in about three
# seconds and there is no room in that for a round trip to Atlas. The archive is
# written exactly once, when a 911 call ends, and read by the replay console at
# /replay afterwards. So the archive can be remote and the store cannot.
#
# "off" means sealed records live in this process only and are lost on restart.
# The console says so in a banner rather than leaving you to notice.
HAWKEYE_REPLAY_ARCHIVE=mongodb

# Used by the archive. Needs `motor` installed: pip install "motor>=3.6".
# One collection, `replays`, one document per sealed record, keyed by incident id.
#
# Atlas refuses the TLS handshake outright when the client IP is not on the
# project's IP Access List, which surfaces as TLSV1_ALERT_INTERNAL_ERROR and
# looks like a certificate problem. It is not. Add the machine's IP under
# Network Access in the Atlas console. The console banner says this too.
HAWKEYE_MONGODB_URI=
HAWKEYE_MONGODB_DATABASE=hawkeye

# ---- live mode only ----
HAWKEYE_MASTER_BASE_URL=http://127.0.0.1:8900

# ---- simulated mode only ----
# Multiply every scripted delay. 0.25 runs a rehearsal four times faster.
HAWKEYE_SIM_SPEED=1.0
HAWKEYE_SIM_AUTOSTART=false

# ---- Twilio Voice + ElevenLabs, for the call bridge (Twilio Voice is
# paywalled and now dormant; kept for reference) ----
# ALL of these plus the SMS four above are required for a real call. Missing
# any one reads as unconfigured and the call bridge refuses to place a real
# call rather than half-placing one.
HAWKEYE_TWILIO_VOICE_NUMBER=+15550003333
HAWKEYE_TWILIO_CONFERENCE_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HAWKEYE_MOCK_911_NUMBER=+15550004444
HAWKEYE_ELEVENLABS_API_KEY=
HAWKEYE_ELEVENLABS_VOICE_ID=
# ngrok URL in dev; the real deployed host later. Used to build the TwiML App
# and status-callback webhook URLs Twilio calls back into.
HAWKEYE_PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# --- Retell AI (the real call transport; Twilio Voice is paywalled/dormant) ---
# Free calling. Create an agent set to Custom LLM pointing at
#   wss://<public-host>/retell/llm-websocket/<HAWKEYE_RETELL_WEBSOCKET_SECRET>
# with TTS provider = ElevenLabs and voice = HAWKEYE_ELEVENLABS_VOICE_ID above.
HAWKEYE_CALL_TRANSPORT=retell            # retell | twilio | simulated
HAWKEYE_RETELL_API_KEY=
HAWKEYE_RETELL_FROM_NUMBER=              # your Retell-owned E.164 number
HAWKEYE_RETELL_AGENT_ID=                 # the Custom-LLM agent id
HAWKEYE_RETELL_WEBSOCKET_SECRET=         # static secret in the WS URL path
# The operator's phone (teammate acting as 911) reuses HAWKEYE_MOCK_911_NUMBER.

# ---- serving ----
HAWKEYE_HOST=0.0.0.0
HAWKEYE_PORT=8787

# ---- NOT read by this service ----
# ElevenLabs, Gemini, TimescaleDB/DATABASE_URL, CORS_ORIGIN and any VITE_*
# variable are read by nothing in this repository today. If a component that
# needs them lands later, give it its own example file next to its own code
# rather than adding them here, so this file keeps meaning "what the hub reads".
