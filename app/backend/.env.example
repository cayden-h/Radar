# Copy to app/backend/.env and fill in. Never commit the filled-in copy.
# `.env` is gitignored; this example is not, so it must never carry a real value.
#
# Every name here is prefixed HAWKEYE_ because Settings uses
# env_prefix="HAWKEYE_" (see hawkeye_backend/config.py). A variable without
# that prefix is read by nothing, silently.

# ---- the one switch ----
# "simulated" needs no hardware and no agents up. "live" talks to agents/master
# and returns 503 rather than inventing state when the mesh is down.
HAWKEYE_MODE=simulated

# ---- identity and address ----
HAWKEYE_HUB_NAME=Hawk Eye Hub
HAWKEYE_SITE_ID=site-demo-01
HAWKEYE_SITE_ADDRESS=1872 Ridgeview Lane, Blacksburg VA 24060
HAWKEYE_SITE_TIMEZONE=America/New_York

# ---- notices ----
# Seconds an unexpected presence must hold before it becomes a notice.
HAWKEYE_NOTICE_HOLD_S=5
# Seconds of absence after which a fired notice mark lapses, so a genuine
# re-entry notifies again and a brief CSI dropout does not.
HAWKEYE_NOTICE_FORGET_AFTER_S=900

# ---- Twilio, for the SMS sink ----
# ALL FOUR are required together. Three out of four reads as unconfigured and
# logs "notices: twilio not configured, in-app banner only", so the in-app
# banner still works and no text ever arrives. That failure looks exactly like
# Twilio being slow. Check the startup log line, not the banner.
#
# The account SID and auth token come from the Twilio console dashboard.
# The from number is the Twilio number itself. On a trial account the TO number
# must be verified in the console first, and every message arrives prefixed
# "Sent from your Twilio trial account".
HAWKEYE_TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
HAWKEYE_TWILIO_AUTH_TOKEN=00000000000000000000000000000000
HAWKEYE_TWILIO_FROM_NUMBER=+15550001111
HAWKEYE_TWILIO_TO_NUMBER=+15550002222

# Rate limits on the SMS sink. A rehearsal loop must not send fifty texts and a
# bug in the trigger must not burn the trial credit.
HAWKEYE_TWILIO_MIN_INTERVAL_S=60
HAWKEYE_TWILIO_MAX_PER_INSTANCE=5

# ---- storage ----
# "memory" is the hackathon path and needs nothing else. "mongodb" is the
# MongoDB Atlas sponsor track and is NOT implemented yet; see store.py.
HAWKEYE_STORE_BACKEND=memory
HAWKEYE_MONGODB_URI=
HAWKEYE_MONGODB_DATABASE=hawkeye

# ---- live mode only ----
HAWKEYE_MASTER_BASE_URL=http://127.0.0.1:8900

# ---- simulated mode only ----
# Multiply every scripted delay. 0.25 runs a rehearsal four times faster.
HAWKEYE_SIM_SPEED=1.0
HAWKEYE_SIM_AUTOSTART=false

# ---- serving ----
HAWKEYE_HOST=0.0.0.0
HAWKEYE_PORT=8787

# ---- NOT read by this service ----
# ElevenLabs, Gemini, TimescaleDB/DATABASE_URL, CORS_ORIGIN and any VITE_*
# variable are read by nothing in this repository today. If a component that
# needs them lands later, give it its own example file next to its own code
# rather than adding them here, so this file keeps meaning "what the hub reads".
