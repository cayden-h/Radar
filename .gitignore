.DS_Store
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Node
node_modules/

# Blender / render output
*.blend1
render/

# agents/ card build output. Cards are build artifacts, regenerated by
# scripts/build_cards.py; `--check` compares content rather than signature
# bytes, so committing them would only add churn from the per-run signing key.
agents/build/

# Claude Code session state. `.claude/worktrees/` holds registered git
# worktrees - full checkouts of this repo - so committing it would nest the
# repo inside itself.
.claude/

# ANS registration material. Private keys for the five agents' identity and
# server certificates, issued 2026-09-19. Never commit these: the identity key
# IS the agent, and anything holding it can speak as a verified Hawk Eye agent.
agents/.ans/
